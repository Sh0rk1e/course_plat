rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == "anonymous";
    }

    // Admin authorization comes exclusively from Firebase Authentication
    // custom claims. Firestore profile fields and email addresses are never
    // used to grant admin access.
    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true
        || request.auth.token.isAdmin == true
        || request.auth.token.role == 'admin'
      );
    }

    function isRegisteredUser() {
      return signedIn() && !isAnonymous();
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email;

      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());

      allow update: if signedIn()
        && request.auth.uid == userId;

      allow delete: if isAdmin();
    }


    match /settings/{settingsId} {
      // Course configuration is safe for signed-in users to read.
      // Only admins may create or change it. This avoids permission errors
      // when an admin session is loading the settings page.
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /videos/{videoId} {
      // Guests may retrieve ONLY the explicitly marked intro lesson.
      // Registered users and admins may retrieve all lesson metadata.
      allow read: if signedIn()
        && (
          isAdmin()
          || isRegisteredUser()
          || (isAnonymous() && resource.data.isIntro == true)
        );

      allow create, update, delete: if isAdmin();
    }
  }
}